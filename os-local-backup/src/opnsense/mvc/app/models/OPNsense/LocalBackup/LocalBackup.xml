<model>
    <mount>//OPNsense/LocalBackup</mount>
    <description>Local Backup Settings</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>1</default>
            </enabled>
            <hour type="IntegerField">
                <default>3</default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>23</MaximumValue>
            </hour>
            <minute type="IntegerField">
                <default>0</default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>59</MaximumValue>
            </minute>
            <min_free_space type="IntegerField">
                <default>10</default>
                <MinimumValue>1</MinimumValue>
            </min_free_space>
        </general>
    </items>
</model>
